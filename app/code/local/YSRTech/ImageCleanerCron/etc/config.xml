<?xml version="1.0"?>
<config>
    <modules>
        <YSRTech_ImageCleanerCron>
            <version>1.0.0</version>
        </YSRTech_ImageCleanerCron>
    </modules>
    <global>
        <models>
            <ysrtech_imagecleanercron>
                <class>YSRTech_ImageCleanerCron_Model</class>
            </ysrtech_imagecleanercron>
        </models>
        <helpers>
            <ysrtech_imagecleanercron>
                <class>YSRTech_ImageCleanerCron_Helper</class>
            </ysrtech_imagecleanercron>
        </helpers>
    </global>
    <crontab>
        <jobs>
            <ysrtech_imagecleaner_weekly>
                <schedule>
                    <config_path>admin/ysrtech_imagecleaner/cron_expr</config_path>
                </schedule>
                <run>
                    <model>ysrtech_imagecleanercron/cleaner::cronRun</model>
                </run>
            </ysrtech_imagecleaner_weekly>
        </jobs>
    </crontab>
    <default>
        <admin>
            <ysrtech_imagecleaner>
                <enabled>1</enabled>
                <mode>move</mode>
                <cron_expr>30 3 * * 0</cron_expr>
                <products>1</products>
                <categories>1</categories>
                <product_cache>1</product_cache>
                <wysiwyg>0</wysiwyg>
                <min_age_hours>48</min_age_hours>
                <max_ratio>80</max_ratio>
                <trash_days>30</trash_days>
                <blacklist></blacklist>
            </ysrtech_imagecleaner>
        </admin>
    </default>
</config>
